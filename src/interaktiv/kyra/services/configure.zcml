<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    xmlns:plone="http://namespaces.plone.org/plone">

    <include package="plone.restapi" file="meta.zcml" />

    <plone:service
        method="GET"
        name="@ai-capabilities"
        factory=".ai_capabilities.AICapabilities"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="POST"
        name="@ai-actions"
        factory=".ai_actions.AIActionsService"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="GET"
        name="@ai-translation-status"
        factory=".ai_actions.AITranslationStatusService"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="POST"
        name="@ai-chat"
        factory=".ai_chat.AIChatService"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="POST"
        name="@ai-chat-upload"
        factory=".ai_chat_upload.AIChatUpload"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="GET"
        name="@ai-tag-mappings"
        factory=".ai_tag_mappings.AITagMappingsService"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="POST"
        name="@ai-tag-mappings"
        factory=".ai_tag_mappings.AITagMappingsService"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="DELETE"
        name="@ai-tag-mappings"
        factory=".ai_tag_mappings.AITagMappingsService"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="GET"
        name="@ai-glossary"
        factory=".deepl_translation.AIGlossaryService"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="POST"
        name="@ai-glossary"
        factory=".deepl_translation.AIGlossaryService"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="DELETE"
        name="@ai-glossary"
        factory=".deepl_translation.AIGlossaryService"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="GET"
        name="@ai-prompts"
        factory=".ai_prompts.AIPromptsService"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="POST"
        name="@ai-prompts"
        factory=".ai_prompts.AIPromptsService"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="PATCH"
        name="@ai-prompts"
        factory=".ai_prompts.AIPromptsService"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="DELETE"
        name="@ai-prompts"
        factory=".ai_prompts.AIPromptsService"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="POST"
        name="@ai-assistant-run"
        factory=".ai_assistant_run.AIAssistantRunService"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="GET"
        name="@ai-prompt-files"
        factory=".prompt_files.PromptFilesService"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="POST"
        name="@ai-prompt-files"
        factory=".prompt_files.PromptFilesService"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="DELETE"
        name="@ai-prompt-files"
        factory=".prompt_files.PromptFilesService"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="GET"
        name="@ai-permission-matrix"
        factory=".ai_permission_matrix.AIPermissionMatrixGet"
        for="*"
        permission="interaktiv.kyra.manage.settings"
    />

    <plone:service
        method="POST"
        name="@ai-permission-matrix"
        factory=".ai_permission_matrix.AIPermissionMatrixPost"
        for="*"
        permission="interaktiv.kyra.manage.settings"
    />

    <!-- Edit proxy (external layout-agent backend) -->
    <plone:service
        method="POST"
        name="@ai-edit-conversations"
        factory=".ai_edit_proxy.AIEditCreateConversation"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="POST"
        name="@ai-edit-messages"
        factory=".ai_edit_proxy.AIEditSendMessage"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="GET"
        name="@ai-edit-jobs"
        factory=".ai_edit_proxy.AIEditPollJob"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="POST"
        name="@ai-edit-job-cancel"
        factory=".ai_edit_proxy.AIEditCancelJob"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="GET"
        name="@ai-edit-messages"
        factory=".ai_edit_proxy.AIEditGetMessages"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="GET"
        name="@ai-edit-message"
        factory=".ai_edit_proxy.AIEditGetMessage"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="GET"
        name="@ai-edit-skills"
        factory=".ai_edit_proxy.AIEditGetSkills"
        for="*"
        permission="zope2.View"
    />

    <!-- Chat proxy (read-only layout-agent backend) -->
    <plone:service
        method="POST"
        name="@ai-chat-conversations"
        factory=".ai_chat_proxy.AIChatCreateConversation"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="POST"
        name="@ai-chat-messages"
        factory=".ai_chat_proxy.AIChatSendMessage"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="GET"
        name="@ai-chat-jobs"
        factory=".ai_chat_proxy.AIChatPollJob"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="POST"
        name="@ai-chat-job-cancel"
        factory=".ai_chat_proxy.AIChatCancelJob"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="GET"
        name="@ai-chat-messages"
        factory=".ai_chat_proxy.AIChatGetMessages"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="GET"
        name="@ai-chat-message"
        factory=".ai_chat_proxy.AIChatGetMessage"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="GET"
        name="@ai-chat-skills"
        factory=".ai_chat_proxy.AIChatGetSkills"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="GET"
        name="@ai-chat-history"
        factory=".ai_chat_history.AIChatHistoryGet"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="PATCH"
        name="@ai-chat-history"
        factory=".ai_chat_history.AIChatHistoryPatch"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="PUT"
        name="@ai-chat-history"
        factory=".ai_chat_history.AIChatHistoryPut"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="DELETE"
        name="@ai-chat-history"
        factory=".ai_chat_history.AIChatHistoryDelete"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="POST"
        name="@ai-error-report"
        factory=".ai_error_report.AIErrorReport"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="POST"
        name="@ai-callback-page"
        factory=".ai_callbacks.AICallbackPage"
        for="*"
        permission="zope.Public"
    />

    <plone:service
        method="POST"
        name="@ai-callback-metadata"
        factory=".ai_callbacks.AICallbackMetadata"
        for="*"
        permission="zope.Public"
    />

    <plone:service
        method="POST"
        name="@ai-callback-children"
        factory=".ai_callbacks.AICallbackChildren"
        for="*"
        permission="zope.Public"
    />

    <plone:service
        method="POST"
        name="@ai-callback-search"
        factory=".ai_callbacks.AICallbackSearch"
        for="*"
        permission="zope.Public"
    />

    <plone:service
        method="POST"
        name="@ai-callback-breadcrumb"
        factory=".ai_callbacks.AICallbackBreadcrumb"
        for="*"
        permission="zope.Public"
    />

    <plone:service
        method="POST"
        name="@ai-callback-documents-search"
        factory=".ai_callbacks.AICallbackDocumentsSearch"
        for="*"
        permission="zope.Public"
    />

    <plone:service
        method="POST"
        name="@ai-callback-documents-read"
        factory=".ai_callbacks.AICallbackDocumentsRead"
        for="*"
        permission="zope.Public"
    />

    <plone:service
        method="POST"
        name="@ai-callback-image"
        factory=".ai_callbacks.AICallbackImage"
        for="*"
        permission="zope.Public"
    />

</configure>
