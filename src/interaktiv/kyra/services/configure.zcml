<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:zcml="http://namespaces.zope.org/zcml"
    xmlns:plone="http://namespaces.plone.org/plone">

    <include package="plone.restapi" file="meta.zcml" />

    <plone:service
        method="GET"
        name="@ai-capabilities"
        factory=".ai_capabilities.AICapabilities"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="POST"
        name="@ai-actions"
        factory=".ai_actions.AIActionsService"
        for="*"
        permission="interaktiv.kyra.actions.apply"
    />

    <plone:service
        method="GET"
        name="@ai-translation-status"
        factory=".ai_actions.AITranslationStatusService"
        for="*"
        permission="zope2.View"
    />

    <plone:service
        method="POST"
        name="@ai-chat"
        factory=".ai_chat.AIChatService"
        for="*"
        permission="interaktiv.kyra.chat"
    />

    <plone:service
        method="POST"
        name="@ai-chat-upload"
        factory=".ai_chat_upload.AIChatUpload"
        for="*"
        permission="interaktiv.kyra.chat"
    />

    <plone:service
        method="GET"
        name="@ai-tag-mappings"
        factory=".ai_tag_mappings.AITagMappingsService"
        for="*"
        permission="interaktiv.kyra.manage.tagmappings"
    />

    <plone:service
        method="POST"
        name="@ai-tag-mappings"
        factory=".ai_tag_mappings.AITagMappingsService"
        for="*"
        permission="interaktiv.kyra.manage.tagmappings"
    />

    <plone:service
        method="DELETE"
        name="@ai-tag-mappings"
        factory=".ai_tag_mappings.AITagMappingsService"
        for="*"
        permission="interaktiv.kyra.manage.tagmappings"
    />

    <plone:service
        method="GET"
        name="@ai-glossary"
        factory=".deepl_translation.AIGlossaryService"
        for="*"
        permission="interaktiv.kyra.manage.glossary"
    />

    <plone:service
        method="POST"
        name="@ai-glossary"
        factory=".deepl_translation.AIGlossaryService"
        for="*"
        permission="interaktiv.kyra.manage.glossary"
    />

    <plone:service
        method="DELETE"
        name="@ai-glossary"
        factory=".deepl_translation.AIGlossaryService"
        for="*"
        permission="interaktiv.kyra.manage.glossary"
    />

    <plone:service
        method="GET"
        name="@ai-prompts"
        factory=".ai_prompts.AIPromptsService"
        for="*"
        permission="interaktiv.kyra.manage.prompts"
    />

    <plone:service
        method="POST"
        name="@ai-prompts"
        factory=".ai_prompts.AIPromptsService"
        for="*"
        permission="interaktiv.kyra.manage.prompts"
    />

    <plone:service
        method="PATCH"
        name="@ai-prompts"
        factory=".ai_prompts.AIPromptsService"
        for="*"
        permission="interaktiv.kyra.manage.prompts"
    />

    <plone:service
        method="DELETE"
        name="@ai-prompts"
        factory=".ai_prompts.AIPromptsService"
        for="*"
        permission="interaktiv.kyra.manage.prompts"
    />

    <plone:service
        method="POST"
        name="@ai-assistant-run"
        factory=".ai_assistant_run.AIAssistantRunService"
        for="*"
        permission="interaktiv.kyra.assistant.run"
    />

    <plone:service
        method="GET"
        name="@ai-prompt-files"
        factory=".prompt_files.PromptFilesService"
        for="*"
        permission="interaktiv.kyra.manage.prompts"
    />

    <plone:service
        method="POST"
        name="@ai-prompt-files"
        factory=".prompt_files.PromptFilesService"
        for="*"
        permission="interaktiv.kyra.manage.prompts"
    />

    <plone:service
        method="DELETE"
        name="@ai-prompt-files"
        factory=".prompt_files.PromptFilesService"
        for="*"
        permission="interaktiv.kyra.manage.prompts"
    />

    <plone:service
        method="GET"
        name="@ai-permission-matrix"
        factory=".ai_permission_matrix.AIPermissionMatrixGet"
        for="*"
        permission="interaktiv.kyra.manage.settings"
    />

    <plone:service
        method="POST"
        name="@ai-permission-matrix"
        factory=".ai_permission_matrix.AIPermissionMatrixPost"
        for="*"
        permission="interaktiv.kyra.manage.settings"
    />

    <plone:service
        method="POST"
        name="@ai-edit-conversations"
        factory=".ai_edit_engine.AIEditCreateConversation"
        for="*"
        permission="interaktiv.kyra.actions.apply"
    />

    <plone:service
        method="POST"
        name="@ai-edit-messages"
        factory=".ai_edit_engine.AIEditSendMessage"
        for="*"
        permission="interaktiv.kyra.actions.apply"
    />

    <plone:service
        method="GET"
        name="@ai-edit-jobs"
        factory=".ai_edit_engine.AIEditPollJob"
        for="*"
        permission="interaktiv.kyra.actions.apply"
    />

    <plone:service
        method="POST"
        name="@ai-edit-job-cancel"
        factory=".ai_edit_engine.AIEditCancelJob"
        for="*"
        permission="interaktiv.kyra.actions.apply"
    />

    <plone:service
        method="GET"
        name="@ai-chat-history"
        factory=".ai_chat_history.AIChatHistoryGet"
        for="*"
        permission="interaktiv.kyra.chat"
    />

    <plone:service
        method="PATCH"
        name="@ai-chat-history"
        factory=".ai_chat_history.AIChatHistoryPatch"
        for="*"
        permission="interaktiv.kyra.chat"
    />

    <plone:service
        method="PUT"
        name="@ai-chat-history"
        factory=".ai_chat_history.AIChatHistoryPut"
        for="*"
        permission="interaktiv.kyra.chat"
    />

    <plone:service
        method="DELETE"
        name="@ai-chat-history"
        factory=".ai_chat_history.AIChatHistoryDelete"
        for="*"
        permission="interaktiv.kyra.chat"
    />

    <plone:service
        method="POST"
        name="@ai-error-report"
        factory=".ai_error_report.AIErrorReport"
        for="*"
        permission="interaktiv.kyra.chat"
    />

</configure>
